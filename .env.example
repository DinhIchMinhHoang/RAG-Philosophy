# =========================
# Core Runtime
# =========================
DATABASE_URL=sqlite:///./rag_system.db
APP_ENV=development
REDIS_BROKER_URL=redis://redis:6379/0
REDIS_RESULT_BACKEND=redis://redis:6379/1
PIPELINE_VERSION=1.0.0
SERVICE_NAME=ingest-worker
API_SERVICE_NAME=backend-api
CELERY_INGEST_QUEUE=ingest
CELERY_MAX_RETRIES=5
CELERY_RETRY_BACKOFF_MAX=300
MAX_PDF_SIZE_MB=100

# =========================
# Database + Broker Container Credentials
# =========================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag_db

# =========================
# Qdrant
# =========================
# Prefer URL form in containerized deployment:
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Fallback host/port form (used if QDRANT_URL is empty):
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=rag_philosophy

# =========================
# Object Storage
# =========================
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_LOCAL_ROOT=/app/data/object_store
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rag-documents
MINIO_SECURE=false

# =========================
# Auth / Security
# =========================
SECRET_KEY=change-this-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# =========================
# LLM / RAG
# =========================
# LLM_MODE controls fallback behavior: auto, gemini, opencode, or local.
LLM_MODE=gemini
# LLM_MODEL auto-selects provider by name when LLM_PROVIDER=auto:
#   gemini-* -> Gemini API
#   anything else, e.g. deepseek-v4-flash -> OpenCode OpenAI-compatible API
LLM_PROVIDER=auto
LLM_MODEL=gemini-3.1-flash-lite-preview
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
COHERE_API_KEY=your-cohere-api-key-here
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL_NAME=glm-ocr
OLLAMA_MAX_WORKERS=5
VLM_TIMEOUT_SECONDS=60
MAX_IMAGE_LONG_EDGE=1500
DPI_FOR_OCR=150

# Retrieval strategy selector for app-level runtime toggles
RETRIEVAL_MODE=dense
RETRIEVAL_TOP_K=5
LOCAL_LLM_BASE_URL=http://ollama:11434
LOCAL_LLM_MODEL=llama3.1:8b

# =========================
# SMTP / Email (for password reset)
# =========================
# Leave SMTP_HOST empty to fall back to printing codes to console (dev mode).
# For production, use a real SMTP server (Gmail, SendGrid, Mailtrap, etc.).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=lumninanotebook@gmail.com
SMTP_PASSWORD=app-password-here
SMTP_USE_TLS=true
EMAIL_FROM=lumninanotebook@gmail.com

# =========================
# Evaluation / Optional Integrations
# =========================
OPENCODE_API_KEY=your-opencode-go-api-key-here
OPENCODE_API_BASE=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=deepseek-v4-pro

EMBEDDING_MODEL_NAME=microsoft/harrier-oss-v1-270m
EMBEDDING_DEVICE=cpu

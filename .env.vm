# =========================
# VM Runtime: 2vCPU / 8GB
# =========================
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/rag_db
APP_ENV=production
REDIS_BROKER_URL=redis://redis:6379/0
REDIS_RESULT_BACKEND=redis://redis:6379/1
PIPELINE_VERSION=1.0.0
SERVICE_NAME=ingest-worker
API_SERVICE_NAME=backend-api
CELERY_INGEST_QUEUE=ingest
CELERY_MAX_RETRIES=5
CELERY_RETRY_BACKOFF_MAX=300
SYNC_INGEST_WHEN_QUEUE_IDLE=false
MAX_UPLOAD_SIZE_MB=20
MAX_PDF_SIZE_MB=100

# =========================
# Container Credentials
# =========================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag_db

# =========================
# Qdrant
# =========================
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=rag_philosophy

# =========================
# Object Storage
# =========================
OBJECT_STORAGE_BACKEND=minio
OBJECT_STORAGE_LOCAL_ROOT=/app/data/object_store
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rag-documents
MINIO_SECURE=false

# =========================
# Auth / Security
# =========================
SECRET_KEY=change-this-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# =========================
# Cloud LLM / OCR
# =========================
LLM_MODE=gemini
LLM_PROVIDER=auto
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
COHERE_API_KEY=your-cohere-api-key-here
OCR_PROVIDER=zai
OCR_API_BASE_URL=https://api.z.ai/api/paas/v4/layout_parsing
OCR_API_KEY=your-zai-api-key-here
OCR_MODEL=glm-ocr
OCR_MAX_WORKERS=3
OCR_TIMEOUT_SECONDS=60
OCR_RENDER_DPI=150
OCR_MAX_IMAGE_LONG_EDGE=1500

# =========================
# Retrieval / Embedding
# =========================
RETRIEVAL_MODE=dense
RETRIEVAL_TOP_K=5
EMBEDDING_SERVICE_URL=http://embedding:8000
EMBEDDING_MODEL_NAME=microsoft/harrier-oss-v1-270m
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
EMBEDDING_QUERY_TIMEOUT_SECONDS=3.0
EMBEDDING_QUERY_RETRIES=1
EMBEDDING_BATCH_TIMEOUT_SECONDS=120.0
EMBEDDING_BATCH_RETRIES=2
